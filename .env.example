# AI Job Agent Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# LLM Configuration
# ============================================================================
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=2
LLM_TIMEOUT=60

# Alternative: OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1

# Alternative: Gemini
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Embedding Configuration
# ============================================================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ============================================================================
# Text Processing Configuration
# ============================================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ============================================================================
# Resume Ranking Configuration
# ============================================================================
CHUNK_SCORE_MULTIPLIER=10
SKILL_MATCH_BONUS=15

# ============================================================================
# Email Configuration
# ============================================================================
EMAIL_SIGNATURE_FORMAT=professional
EMAIL_WORD_COUNT_MIN=90
EMAIL_WORD_COUNT_MAX=140

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_TYPE=sqlite
# For PostgreSQL:
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/jobagent

# ============================================================================
# Directory Paths (optional - defaults to project subdirectories)
# ============================================================================
# RESUME_DIR=/path/to/resumes
# DATABASE_DIR=/path/to/database
# VECTOR_DB_DIR=/path/to/vector_db
# CONFIG_DIR=/path/to/config
# LOGS_DIR=/path/to/logs

# ============================================================================
# Streamlit Configuration
# ============================================================================
STREAMLIT_PORT=0
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=true

# ============================================================================
# Application Configuration
# ============================================================================
APP_NAME=AI Job Agent
APP_VERSION=2.0.0
DEBUG=false

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# ============================================================================
# Cache Configuration
# ============================================================================
CACHE_ENABLED=true
CACHE_TTL=3600

# ============================================================================
# Browser Automation Configuration
# ============================================================================
BROWSER_HEADLESS=true
BROWSER_TYPE=chromium
BROWSER_SLOW_MO=0
BROWSER_TIMEOUT=30000

# ============================================================================
# Overleaf Configuration
# ============================================================================
OVERLEAF_URL=https://www.overleaf.com
OVERLEAF_EMAIL=your_overleaf_email@example.com
OVERLEAF_PASSWORD=your_overleaf_password
OVERLEAF_DEFAULT_PROJECT=Master Resume

# ============================================================================
# Automation Session Configuration
# ============================================================================
SESSION_PERSIST_ENABLED=true
SESSION_EXPIRY_HOURS=24
AUTOMATION_MAX_RETRIES=3
AUTOMATION_RETRY_BACKOFF_BASE=2
AUTOMATION_RETRY_BACKOFF_MAX=10

# ============================================================================
# Editor Configuration
# ============================================================================
EDITOR_LOAD_TIMEOUT=30000
AUTOSAVE_WAIT_TIMEOUT=10000
COMPILE_TIMEOUT=60000
DOWNLOAD_TIMEOUT=30000

# ============================================================================
# Automation Logging Configuration
# ============================================================================
AUTOMATION_LOG_LEVEL=INFO

# ============================================================================
# Visual Execution Mode Configuration
# ============================================================================
# Set to true to enable visual debugging mode (browser visible, slow motion, screenshots)
DEBUG_MODE=true
VISUAL_MODE=true

# Visual Mode Settings (only used when DEBUG_MODE or VISUAL_MODE is true)
VISUAL_SLOW_MO=500
VISUAL_TYPING_DELAY=50
VISUAL_PAUSE_AFTER_ACTION=300
VISUAL_VIEWPORT_WIDTH=1920
VISUAL_VIEWPORT_HEIGHT=1080
VISUAL_KEEP_BROWSER_OPEN=true
VISUAL_BROWSER_CLOSE_DELAY=30

# Screenshot Configuration
SCREENSHOT_ENABLED=true
SCREENSHOT_ON_MILESTONE=true
SCREENSHOT_ON_ERROR=true

# Video Recording Configuration
VIDEO_ENABLED=true
VIDEO_SIZE=1920x1080
